{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "redis:6379,password=StrongRedisPass!123,abortConnect=false"
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "appuser",
    "Password": "StrongRabbitPass!123"
  },
  "Jwt": {
    "Key": "ReplaceThisWithAReallyStrongKeyOrUseEnvironmentVariable",
    "Issuer": "JwtTokenService",
    "Audience": "JwtTokenServiceClients",
    "ExpireMinutes": 60
  }
}