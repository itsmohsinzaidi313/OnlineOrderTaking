# Shared hosts, ports and credentials (used by multiple services)
# Hosts
HAPROXY_HOST=haproxy
ETCD_HOST=etcd
RABBITMQ_HOSTNAME=rabbitmq
REDIS_HOST=redis

# Postgres / DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespass
PGDATA=/var/lib/postgresql/data/pgdata

# Centralized SQL connection strings
# RWSQLCONNECTION: read-write (primary)
# NOTE: docker-compose does not expand nested ${VAR} inside .env values, so provide fully expanded strings here.
RWSQLCONNECTION=Host=haproxy;Port=5433;Database=builderburger;Username=postgres;Password=postgrespass;
# ROSQLCONNECTION: read-only (replica)
ROSQLCONNECTION=Host=haproxy;Port=5434;Database=builderburger;Username=postgres;Password=postgrespass;

# HAProxy ports (primary and replica / read-only)
HAPROXY_PORT_PRIMARY=5433
HAPROXY_PORT_REPLICA=5434
HAPROXY_STATS_PORT=8404

# RabbitMQ credentials
RABBITMQ_DEFAULT_USER=appuser
RABBITMQ_DEFAULT_PASS=StrongRabbitPass!123
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_PORT=5672

# Redis credentials
REDIS_PASSWORD=StrongRedisPass!123
REDIS_PORT=6379

# ETCD
ETCD_NAME=patroni-etcd
ETCD_DATA_DIR=/etcd-data
ETCD_LISTEN_CLIENT_URLS=http://0.0.0.0:2379
ETCD_LISTEN_PEER_URLS=http://0.0.0.0:2380
ETCD_ADVERTISE_CLIENT_URLS=http://${ETCD_HOST}:2379

# Patroni
PATRONI_SCOPE=postgres-cluster
PATRONI_NAME=patroni1
PATRONI_NAMESPACE=/service/
PATRONI_ETCD3_HOSTS=${ETCD_HOST}:2379
PATRONI_RESTAPI_LISTEN=0.0.0.0:8008
PATRONI_RESTAPI_CONNECT_ADDRESS=patroni1:8008
PATRONI_POSTGRESQL_LISTEN=0.0.0.0:${HAPROXY_PORT_PRIMARY}
PATRONI_POSTGRESQL_CONNECT_ADDRESS=patroni1:${HAPROXY_PORT_PRIMARY}
PATRONI_POSTGRESQL_DATA_DIR=${PGDATA}
PATRONI_POSTGRESQL_AUTHENTICATION_REPLICATION_USERNAME=replicator
PATRONI_POSTGRESQL_AUTHENTICATION_REPLICATION_PASSWORD=replicatorpass
PATRONI_POSTGRESQL_AUTHENTICATION_SUPERUSER_USERNAME=${POSTGRES_USER}
PATRONI_POSTGRESQL_AUTHENTICATION_SUPERUSER_PASSWORD=${POSTGRES_PASSWORD}

# Service-specific settings now rely on centralized variables
# GetMenuService: uses replica (read) DB via ${ROSQLCONNECTION}

# GatewayService
GATEWAY_ASPNETCORE_ENVIRONMENT=Production
GATEWAY_ASPNETCORE_URLS=http://+:8080

# SeedingService (writes to primary DB)
SEEDINGSERVICE_ASPNETCORE_ENVIRONMENT=Development

# CreateOrderService (uses ${RWSQLCONNECTION} and centralized RabbitMQ creds)
# (connection strings and RabbitMQ vars are centralized above)

# GatewayService JWT
GATEWAY_JWT_KEY=ReplaceThisWithAReallyStrongKeyOrUseEnvironmentVariable
GATEWAY_JWT_ISSUER=JwtTokenService
GATEWAY_JWT_AUDIENCE=JwtTokenServiceClients
GATEWAY_JWT_EXPIREMINUTES=60
