<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.AspNetCore.Server" Version="2.80.0" />
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PointofSaleModels\PointofSaleModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\pushnotification.proto" GrpcServices="Server" Namespace="PointofSaleModels.Protos" />
  </ItemGroup>

</Project>
